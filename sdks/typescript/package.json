{
  "name": "clarive-sdk",
  "version": "0.2.1",
  "description": "Official TypeScript SDK for the Clarive Public API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "author": "Clarive",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinkroosterai/ClariveSDK.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/pinkroosterai/ClariveSDK/tree/main/sdks/typescript",
  "keywords": ["clarive", "sdk", "prompt", "api", "typescript"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "check": "biome check src/ tests/ && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7",
    "vitest": "^3.0"
  }
}
